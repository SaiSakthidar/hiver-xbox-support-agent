# ── Cache (set to 1 to cache LLM responses to disk — saves API cost on reruns) ─
CACHE_LLM=0

# ── Pick ONE backend ──────────────────────────────────────────────────────────
# Options: anthropic | gemini | ollama
LLM_BACKEND=gemini

# ── Anthropic (Claude) ────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=sk-ant-...
# Default model: claude-haiku-4-5-20251001  (fast + cheap)
# Other options: claude-sonnet-4-5, claude-opus-5
# LLM_MODEL=claude-haiku-4-5-20251001

# ── Google Gemini ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your-gemini-api-key-here
# Default model: gemini-2.0-flash
# LLM_MODEL=gemini-2.0-flash

# ── Ollama (local model) ──────────────────────────────────────────────────────
# Install: https://ollama.com  →  ollama pull llama3.2
OLLAMA_MODEL=llama3.2
OLLAMA_BASE_URL=http://localhost:11434
# LLM_MODEL=llama3.2
